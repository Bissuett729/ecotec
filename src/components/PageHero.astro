---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
}
const { eyebrow = '', title, text = '' } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero-bg" aria-hidden="true">
    <span class="ph-orb"></span>
    <span class="ph-grid"></span>
  </div>
  <div class="container page-hero-inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="page-title">{title}</h1>
    {text && <p class="page-text">{text}</p>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 7vw, 5rem) 0 clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .page-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .ph-orb {
    position: absolute;
    width: 520px;
    height: 520px;
    left: -180px;
    top: -180px;
    border-radius: 50%;
    background: rgba(224, 53, 44, 0.14);
    filter: blur(70px);
  }

  .ph-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(60% 90% at 30% 0%, #000, transparent 75%);
  }

  .page-hero-inner {
    position: relative;
    max-width: 860px;
  }

  .page-title {
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    margin: 1.2rem 0 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .page-text {
    margin-top: 1.2rem;
    color: var(--muted);
    font-size: 1.12rem;
    line-height: 1.75;
    max-width: 62ch;
  }
</style>
