---
import Icon from '../ui/Icon.astro';
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <span class="orb orb-a"></span>
    <span class="orb orb-b"></span>
    <span class="grid-lines"></span>
  </div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Carbón de coco premium</p>
      <h1 class="hero-title">
        <span class="line">Calor extremo.</span>
        <span class="line grad-text">Combustión limpia.</span>
      </h1>
      <p class="hero-sub">
        Carbón de coco ECOTEC de alta densidad: hasta 5 horas de fuego por kilo,
        temperatura estable y hasta 60–80% menos consumo que el carbón de madera,
        con mínima emisión de humo y cero químicos.
      </p>
      <div class="hero-cta">
        <a class="btn" href="/comprar">
          Comprar carbón ECOTEC
          <Icon name="arrow" size={18} />
        </a>
      </div>
      <a class="link-arrow wholesale-link" href="/mayoreo">
        ¿Compras para restaurante o distribución? Solicita información aquí
        <Icon name="arrow" size={16} />
      </a>
    </div>

    <div class="hero-media">
      <div class="video-card">
        <p class="video-eyebrow">
          <Icon name="play" size={12} filled />
          Verlo en acción
        </p>

        <div class="video-stage">
          <div class="stage-glow" aria-hidden="true"></div>
          <span class="coal coal-1" aria-hidden="true"></span>
          <span class="coal coal-2" aria-hidden="true"></span>
          <span class="coal coal-3" aria-hidden="true"></span>
          <span class="spark sp-1" aria-hidden="true"></span>
          <span class="spark sp-2" aria-hidden="true"></span>
          <span class="spark sp-3" aria-hidden="true"></span>
          <button class="play-btn" type="button" aria-label="Reproducir vídeo">
            <Icon name="play" size={26} filled />
          </button>
          <span class="ring" aria-hidden="true"></span>
        </div>

        <ul class="video-bullets">
          <li>
            <span class="b-ico"><Icon name="thermo" size={18} /></span>
            <span>
              <strong>Consistencia en alta temperatura</strong>
              <small>Mantiene hasta 600 °C para un sellado profesional.</small>
            </span>
          </li>
          <li>
            <span class="b-ico"><Icon name="leaf" size={18} /></span>
            <span>
              <strong>100% sustentable y libre de químicos</strong>
              <small>Sin aditivos, sin humo excesivo.</small>
            </span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(3rem, 7vw, 6rem);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
  }

  .orb-a {
    width: 520px;
    height: 520px;
    left: -180px;
    top: 40px;
    background: rgba(224, 53, 44, 0.16);
  }

  .orb-b {
    width: 460px;
    height: 460px;
    right: -140px;
    bottom: -120px;
    background: rgba(255, 122, 38, 0.12);
  }

  .grid-lines {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(80% 70% at 50% 30%, #000 0%, transparent 75%);
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  /* ----- Columna de texto ----- */
  .hero-title {
    margin: 1.4rem 0 1.5rem;
    font-size: clamp(2.7rem, 6.4vw, 5rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .hero-title .line {
    display: block;
  }

  .hero-sub {
    max-width: 54ch;
    color: var(--muted);
    font-size: clamp(1.02rem, 1.6vw, 1.2rem);
    line-height: 1.7;
  }

  .hero-cta {
    margin: 2rem 0 1.4rem;
  }

  .wholesale-link {
    font-size: 0.95rem;
  }

  /* ----- Columna de vídeo ----- */
  .hero-media {
    position: relative;
  }

  .video-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(170deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.008) 45%), var(--panel);
    padding: 1rem 1rem 1.4rem;
    box-shadow: var(--shadow-lg);
  }

  .video-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.4rem 0.9rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .video-eyebrow svg {
    color: var(--brand);
  }

  .video-stage {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: calc(var(--radius) - 6px);
    overflow: hidden;
    border: 1px solid var(--line);
    background:
      radial-gradient(120% 90% at 60% 100%, rgba(224, 53, 44, 0.4), transparent 55%),
      linear-gradient(165deg, #1a1a1e 0%, #131316 55%, #0d0d0f 100%);
  }

  .stage-glow {
    position: absolute;
    left: 15%;
    right: 15%;
    bottom: -6%;
    height: 55%;
    background: radial-gradient(55% 90% at 50% 100%, rgba(255, 88, 30, 0.5), transparent 75%);
    filter: blur(4px);
  }

  .coal {
    position: absolute;
    bottom: 14%;
    height: 34px;
    transform: rotate(-10deg);
    background: linear-gradient(180deg, #2a2a30, #151518);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
    opacity: 0.95;
  }

  .coal-1 { left: 12%; width: 96px; border-radius: 48% 52% 46% 54% / 60% 55% 45% 40%; }
  .coal-2 { left: 42%; width: 108px; border-radius: 52% 48% 56% 44% / 62% 58% 42% 38%; }
  .coal-3 { left: 70%; width: 92px; border-radius: 46% 54% 44% 56% / 58% 46% 54% 42%; }

  .spark {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffe0b0, #ff7a26 55%, transparent 80%);
    box-shadow: 0 0 12px 3px rgba(255, 122, 38, 0.6);
    animation: emberFloat 3s ease-in-out infinite;
  }

  .sp-1 { left: 24%; top: 24%; }
  .sp-2 { left: 55%; top: 16%; animation-delay: 1.1s; }
  .sp-3 { left: 80%; top: 30%; animation-delay: 2s; }

  .play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 74px;
    height: 74px;
    border-radius: 50%;
    border: 0;
    cursor: pointer;
    display: grid;
    place-items: center;
    color: #fff;
    background: var(--grad-brand);
    box-shadow: 0 18px 50px -12px rgba(224, 53, 44, 0.7);
    transition: transform 0.25s ease;
  }

  .play-btn:hover {
    transform: translate(-50%, -50%) scale(1.08);
  }

  .ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 118px;
    height: 118px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    animation: pulse 2.6s ease-out infinite;
    pointer-events: none;
  }

  @keyframes pulse {
    0% { opacity: 0.8; transform: translate(-50%, -50%) scale(0.85); }
    100% { opacity: 0; transform: translate(-50%, -50%) scale(1.25); }
  }

  .video-bullets {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .video-bullets li {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
  }

  .b-ico {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    color: var(--ember);
    background: rgba(255, 122, 38, 0.12);
    border: 1px solid rgba(255, 122, 38, 0.22);
  }

  .video-bullets strong {
    display: block;
    font-size: 0.96rem;
    line-height: 1.3;
  }

  .video-bullets small {
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
