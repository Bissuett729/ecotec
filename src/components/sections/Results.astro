---
import CharcoalArt from '../ui/CharcoalArt.astro';

const items = [
  { label: 'Restaurantes', sub: 'Temperatura estable en hora pico', img: '/images/shashlik.jpg' },
  { label: 'Steakhouses', sub: 'Sellado profesional a 600 °C', img: '/images/meat-corn.jpg' },
  { label: 'Food trucks', sub: 'Menos recargas durante el servicio', img: '/images/bbq-meat.jpg' },
  { label: 'Distribuidores', sub: 'Suministro continuo y escalable', img: '/images/coal-prod.jpg' },
  { label: 'Cocinas de hotel', sub: 'Bajo humo en espacios cerrados', img: '/images/embers.jpg' },
];

// Duplica los elementos para el marquee infinito y marca la segunda copia
const galleryItems = [...items, ...items].map((it, i) => ({ it, dup: i >= items.length }));
---

<section class="results">
  <div class="container">
    <div class="results-head">
      <p class="eyebrow">Experiencia en operación</p>
      <h2 class="results-title">Resultados reales en cocina profesional</h2>
      <p class="results-text">
        Descubre cómo el carbón de coco ECOTEC mantiene temperatura estable, reduce
        humo y mejora el control del fuego en cocinas profesionales y parrillas de
        alto rendimiento.
      </p>
    </div>
  </div>

  <div class="gallery" aria-label="Galería de casos de uso">
    <div class="gallery-track">
      {galleryItems.map(({ it, dup }) => (
        <figure class="shot" aria-hidden={dup}>
          <div class="shot-media"><CharcoalArt label="" image={it.img} alt={`${it.label} — ${it.sub}`} eager /></div>
          <figcaption>
            <strong>{it.label}</strong>
            <span>{it.sub}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .results {
    padding: clamp(4rem, 8vw, 6.5rem) 0;
    border-top: 1px solid var(--line);
    background: var(--bg-soft);
    overflow: hidden;
  }

  .results-head {
    text-align: center;
    display: grid;
    justify-items: center;
    max-width: 760px;
    margin-inline: auto;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .results-title {
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    margin: 1.2rem 0 1rem;
  }

  .results-text {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .gallery {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .gallery-track {
    display: flex;
    gap: 1.3rem;
    width: max-content;
    animation: marquee 34s linear infinite;
  }

  .gallery:hover .gallery-track {
    animation-play-state: paused;
  }

  .shot {
    margin: 0;
    width: clamp(240px, 30vw, 340px);
    flex-shrink: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--panel);
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .shot:hover {
    transform: translateY(-4px);
    border-color: rgba(13, 148, 136, 0.45);
  }

  .shot-media .art-stage {
    min-height: 200px;
    border-radius: 0;
    border: 0;
  }

  .shot figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.15rem;
  }

  .shot strong {
    font-size: 1.02rem;
  }

  .shot span {
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
