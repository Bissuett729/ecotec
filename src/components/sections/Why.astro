---
import Icon from '../ui/Icon.astro';

const chips = [
  { icon: 'gauge', text: 'Mayor densidad que el carbón de leña' },
  { icon: 'clock', text: 'Energía lenta y constante, hasta 5 h por kg' },
  { icon: 'shield', text: 'Temperatura estable durante toda la cocción' },
];
---

<section class="why">
  <div class="container">
    <div class="why-inner">
      <h2 class="why-title">¿Por qué el carbón de coco dura más?</h2>
      <p class="why-text">
        El carbón de coco ECOTEC tiene mayor densidad que el carbón tradicional de
        madera. Eso significa que libera su energía de forma más lenta y constante:
        un solo kilo rinde hasta 5 horas y mantiene una temperatura más estable
        durante toda la cocción, con menos recargas y menos humo.
      </p>
      <div class="why-chips">
        {
          chips.map((c) => (
            <span class="chip">
              <Icon name={c.icon} size={18} />
              {c.text}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .why {
    position: relative;
    padding: clamp(3rem, 7vw, 5.5rem) 0;
  }

  .why::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(900px 400px at 50% 0%, rgba(13, 148, 136, 0.12), transparent 70%);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background-color: var(--bg-soft);
  }

  .why-inner {
    position: relative;
    max-width: 820px;
    margin-inline: auto;
    text-align: center;
  }

  .why-title {
    font-size: clamp(1.9rem, 4.2vw, 3.1rem);
    margin-bottom: 1.4rem;
  }

  .why-text {
    color: var(--muted);
    font-size: clamp(1.02rem, 1.8vw, 1.2rem);
    line-height: 1.8;
  }

  .why-chips {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.03);
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .chip svg {
    color: var(--ember);
  }
</style>
