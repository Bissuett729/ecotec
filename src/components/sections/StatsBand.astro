---
const stats = [
  { value: '5 h/kg', label: 'Hasta 5 horas de fuego por kilo' },
  { value: '600 °C', label: 'Consistencia en alta temperatura' },
  { value: '60–80%', label: 'Menos consumo que el carbón de madera' },
  { value: '24/7', label: 'Suministro continuo y escalable' },
];
---

<section class="stats">
  <div class="container">
    <div class="stats-panel">
      {
        stats.map((s, i) => (
          <div class="stat" aria-label={s.label}>
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
            {i < stats.length - 1 && <span class="stat-sep" aria-hidden="true"></span>}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stats {
    padding: 0 0 clamp(3.5rem, 7vw, 6rem);
  }

  .stats-panel {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.005)), var(--bg-soft);
    overflow: hidden;
  }

  .stat {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: clamp(1.4rem, 3vw, 2.2rem);
  }

  .stat-value {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    line-height: 1;
  }

  .stat-label {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.45;
    max-width: 20ch;
  }

  .stat-sep {
    position: absolute;
    top: 22%;
    bottom: 22%;
    right: 0;
    width: 1px;
    background: var(--line);
  }

  @media (max-width: 900px) {
    .stats-panel {
      grid-template-columns: 1fr 1fr;
    }

    .stat-sep:nth-of-type(2n) {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .stats-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
