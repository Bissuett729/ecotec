---
import Icon from './ui/Icon.astro';

interface Props {
  active?: string;
}

const { active = '' } = Astro.props;

const links = [
  { href: '/', label: 'Portada', id: 'portada' },
  { href: '/comprar', label: 'Comprar Carbón', id: 'comprar' },
  { href: '/por-que-ecotec', label: '¿Por qué ECOTEC?', id: 'porque' },
  { href: '/mayoreo', label: 'Mayoreo', id: 'mayoreo' },
  { href: '/contacto', label: 'Contacto', id: 'contacto' },
];
---

<header class="site-header" id="top">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="ECOTEC — Portada">
      <span class="brand-mark" aria-hidden="true">
        <Icon name="flame" size={20} filled />
      </span>
      <span class="brand-name">ECOTEC</span>
    </a>

    <nav class="nav" aria-label="Menu">
      <ul class="nav-list">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class:list={['nav-link', { 'is-active': active === l.id }]}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a href="#cart" class="cart" aria-label="0 artículos en el carrito">
        <span class="cart-count">0</span>
        <Icon name="bag" size={20} />
        <span class="cart-label">Cart</span>
      </a>
      <button class="nav-toggle" type="button" data-menu-toggle aria-label="Abrir menú">
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>

  <nav class="mobile-nav" data-mobile-nav aria-label="Menú móvil">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(11, 11, 12, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 76px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    color: #fff;
    background: var(--grad-brand);
    box-shadow: var(--shadow-glow);
  }

  .brand-name {
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: 0.18em;
  }

  .nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    position: relative;
    display: block;
    padding: 0.55rem 0.95rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.2s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.95rem;
    right: 0.95rem;
    bottom: 0.1rem;
    height: 2px;
    border-radius: 2px;
    background: var(--grad-brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--text);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .cart {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text);
    font-size: 0.82rem;
    font-weight: 600;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .cart:hover {
    border-color: var(--brand);
    background: rgba(224, 53, 44, 0.1);
  }

  .cart-count {
    display: grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding-inline: 5px;
    border-radius: 999px;
    background: var(--grad-brand);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .nav-toggle {
    display: none;
    background: none;
    border: 0;
    color: var(--text);
    cursor: pointer;
    padding: 0.4rem;
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 920px) {
    .nav {
      display: none;
    }

    .cart-label {
      display: none;
    }

    .nav-toggle {
      display: inline-grid;
      place-items: center;
    }

    .mobile-nav.is-open {
      display: block;
      border-top: 1px solid var(--line);
      background: var(--bg-soft);
      padding: 0.5rem 0 1rem;
    }

    .mobile-nav ul {
      list-style: none;
      margin: 0;
      padding: 0 var(--gutter);
      display: grid;
    }

    .mobile-nav a {
      display: block;
      padding: 0.9rem 0.2rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      font-size: 0.9rem;
      color: var(--text);
      border-bottom: 1px solid var(--line);
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const panel = document.querySelector('[data-mobile-nav]');
  toggle?.addEventListener('click', () => {
    const open = panel?.classList.toggle('is-open');
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    toggle.setAttribute('aria-expanded', String(open));
  });
  panel?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => panel.classList.remove('is-open'))
  );
</script>
