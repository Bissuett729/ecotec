---
interface Props {
  size?: number;
  class?: string;
}

const { size = 42, class: className = '' } = Astro.props;
---

<img
  class:list={[className, 'brand-logo-img']}
  src="/images/logo-mark.png"
  alt="ECOTEC — conejo con carbón"
  width={size}
  height={size}
  loading="eager"
  decoding="async"
/>

<style>
  .brand-logo-img {
    display: block;
    border-radius: 28%;
    background: #ffffff;
    border: 1px solid var(--line-strong);
    box-shadow: 0 4px 14px rgba(10, 50, 60, 0.08);
  }
</style>
