const filledNames = ['play', 'flame'];
const useFill = filled || filledNames.includes(name);
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={useFill ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]} />
</svg>
