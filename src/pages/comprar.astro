---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/ui/Icon.astro';
import CharcoalArt from '../components/ui/CharcoalArt.astro';

const products = [
  {
    name: 'ECOTEC 5 kg',
    price: '$189',
    note: 'Ideal para probar o una sola parrillada grande.',
    badge: '',
    art: 'Briquetas 5 kg',
  },
  {
    name: 'ECOTEC 10 kg',
    price: '$349',
    note: 'La presentación favorita para asados del fin de semana.',
    badge: 'Más vendido',
    art: 'Briquetas 10 kg',
    featured: true,
  },
  {
    name: 'ECOTEC 20 kg',
    price: '$649',
    note: 'Mejor precio por kilo para parrilleros frecuentes.',
    badge: 'Mejor precio por kg',
    art: 'Briquetas 20 kg',
  },
];
---

<BaseLayout
  title="Comprar carbón ECOTEC"
  description="Compra carbón de coco ECOTEC en presentaciones de 5, 10 y 20 kg con envío a todo México."
  active="comprar"
>
  <PageHero
    eyebrow="Tienda"
    title="Comprar carbón ECOTEC"
    text="Briquetas de carbón de coco premium 100% natural. Elige la presentación que se ajuste a tu parrilla y recíbela en la puerta de tu casa."
  />

  <section class="products section section--tight">
    <div class="container product-grid">
      {
        products.map((p) => (
          <article class:list={['product', { 'product--feat': p.featured }]}>
            <div class="product-media">
              {p.badge && <span class="product-badge">{p.badge}</span>}
              <CharcoalArt label="" />
            </div>
            <div class="product-body">
              <h2 class="product-name">{p.name}</h2>
              <p class="product-note">{p.note}</p>
              <div class="product-bottom">
                <span class="product-price">{p.price} <small>MXN</small></span>
                <a class="btn btn--ghost" href="#top">Agregar al carrito</a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
    <div class="container ship-note">
      <Icon name="truck" size={18} />
      Envío a toda la República Mexicana · Pago seguro · Garantía de calidad
    </div>
  </section>
</BaseLayout>

<style>
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .product {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-soft);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .product:hover {
    transform: translateY(-6px);
    border-color: rgba(255, 255, 255, 0.22);
  }

  .product--feat {
    border-color: rgba(224, 53, 44, 0.45);
  }

  .product-media {
    position: relative;
    padding: 0.9rem 0.9rem 0;
  }

  .product-media .art-stage {
    min-height: 220px;
  }

  .product-badge {
    position: absolute;
    top: 1.4rem;
    left: 1.4rem;
    z-index: 2;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: var(--grad-brand);
    color: #fff;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: var(--shadow-glow);
  }

  .product-body {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: 1.4rem 1.6rem 1.8rem;
    flex: 1;
  }

  .product-name {
    font-size: 1.5rem;
  }

  .product-note {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
    flex: 1;
  }

  .product-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.6rem;
  }

  .product-price {
    font-size: 1.7rem;
    font-weight: 900;
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .product-price small {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--faint);
    -webkit-text-fill-color: var(--faint);
  }

  .ship-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 2.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .ship-note svg {
    color: var(--ember);
  }

  @media (max-width: 980px) {
    .product-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
    }
  }
</style>
